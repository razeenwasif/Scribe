<Window x:Class="Scribe.Views.TableInsertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Table"
        Height="280" Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChromeBrush}"
        Foreground="{DynamicResource TextBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Insert Table" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Columns" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                <Slider x:Name="ColsSlider" Grid.Column="1" Minimum="1" Maximum="12" Value="3"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="ColsSlider_ValueChanged" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Rows" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                <Slider x:Name="RowsSlider" Grid.Column="1" Minimum="1" Maximum="20" Value="3"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        ValueChanged="RowsSlider_ValueChanged" />
            </Grid>

            <TextBlock x:Name="DimensionLabel" Text="3 columns × 3 rows"
                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,8" />

            <CheckBox x:Name="HeaderCheck" Content="Include header row" IsChecked="True"
                      HorizontalAlignment="Left" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Insert" Click="Insert_Click" IsDefault="True" Padding="20,6" />
        </StackPanel>
    </Grid>
</Window>
