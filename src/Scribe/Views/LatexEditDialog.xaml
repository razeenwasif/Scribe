<Window x:Class="Scribe.Views.LatexEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:math="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        Title="LaTeX Equation Formatter"
        Height="520" Width="640"
        MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChromeBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="LaTeX Equation Formatter"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,4,0,10"
                   FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Type standard LaTeX math syntax. The formula will be formatted and rendered on your notebook page." />

        <!-- Formula input -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource CanvasBackdropBrush}">
            <TextBox x:Name="FormulaInput"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="13"
                     Padding="10,8"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource TextBrush}"
                     TextChanged="FormulaInput_TextChanged" />
        </Border>

        <!-- Symbol Snippet Buttons -->
        <WrapPanel Grid.Row="3" Margin="0,8,0,8" Orientation="Horizontal">
            <Button Content="x/y" Tag="\frac{a}{b}" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Fraction: \frac{a}{b}" />
            <Button Content="√x" Tag="\sqrt{x}" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Square root: \sqrt{x}" />
            <Button Content="x²" Tag="x^{2}" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Superscript: x^{2}" />
            <Button Content="xᵢ" Tag="x_{i}" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Subscript: x_{i}" />
            <Button Content="∫" Tag="\int_{a}^{b} f(x) \, dx" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Integral" />
            <Button Content="∑" Tag="\sum_{i=1}^{n} x_i" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Summation" />
            <Button Content="lim" Tag="\lim_{x \to 0}" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Limit" />
            <Button Content="±" Tag="\pm" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Plus-minus" />
            <Button Content="∞" Tag="\infty" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Infinity" />
            <Button Content="α" Tag="\alpha" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Alpha" />
            <Button Content="β" Tag="\beta" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Beta" />
            <Button Content="θ" Tag="\theta" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Theta" />
            <Button Content="π" Tag="\pi" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Pi" />
            <Button Content="≠" Tag="\neq" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Not equal" />
            <Button Content="≤" Tag="\le" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Less than or equal" />
            <Button Content="≥" Tag="\ge" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Greater than or equal" />
            <Button Content="matrix" Tag="\begin{pmatrix} a &amp; b \\ c &amp; d \end{pmatrix}" Click="Snippet_Click" Margin="0,0,5,5" Padding="7,3" FontSize="11" Style="{DynamicResource QuietButtonStyle}" ToolTip="Matrix" />
        </WrapPanel>

        <!-- Preview Box -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Background="{DynamicResource PageSurfaceBrush}" Padding="16">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <math:FormulaControl x:Name="FormulaPreview"
                                         Scale="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="ErrorText"
                               Foreground="#E06C75"
                               FontSize="12"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Scale Control -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="Formula Size" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,0" />
            <Slider x:Name="ScaleSlider" Width="140" Minimum="12" Maximum="48" Value="22"
                    TickFrequency="2" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" ValueChanged="ScaleSlider_ValueChanged" />
            <TextBlock x:Name="ScaleLabel" Text="22 pt" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource TextBrush}" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,6" />
            <Button x:Name="OkButton" Content="Insert Equation" Click="Ok_Click" IsDefault="True" Padding="20,6" />
        </StackPanel>
    </Grid>
</Window>
