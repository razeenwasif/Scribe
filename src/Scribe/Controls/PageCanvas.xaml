<UserControl x:Class="Scribe.Controls.PageCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scribe.Controls"
             xmlns:ink="clr-namespace:Scribe.Ink"
             Focusable="True"
             Background="{DynamicResource CanvasBackdropBrush}">

    <Grid ClipToBounds="True">

        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0"
                      Focusable="False">

            <!-- Zoom is a LayoutTransform so the scrollbars track the scaled
                 size; a RenderTransform would leave them measuring the
                 unscaled page. -->
            <Grid x:Name="ZoomHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="56,40,56,80">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <Border x:Name="PageSurface"
                        Background="{DynamicResource PageSurfaceBrush}"
                        BorderBrush="{DynamicResource PageBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2"
                                          Direction="270"
                                          Opacity="{DynamicResource PageShadowOpacity}"
                                          Color="{DynamicResource PageShadowColor}" />
                    </Border.Effect>

                    <Grid>
                        <controls:PageBackground x:Name="Backdrop" />
                        <ink:ScribeInkCanvas x:Name="Ink" Background="Transparent" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Zoom readout: a floating pill, out of the way until wanted. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,22,22"
                Background="{DynamicResource ElevatedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16" Padding="6,3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.22" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ZoomLabel" Text="100%"
                           FontSize="11.5" MinWidth="40" Margin="8,0,2,0"
                           TextAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />
                <Button Content="Reset" Padding="9,4" FontSize="11"
                        Click="ResetZoom_Click"
                        Style="{DynamicResource QuietButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
