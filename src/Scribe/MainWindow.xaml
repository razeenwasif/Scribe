<Window x:Class="Scribe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Scribe.Controls"
        xmlns:models="clr-namespace:Scribe.Models"
        Title="Scribe"
        Height="900" Width="1440"
        MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- Custom chrome: the app draws its own caption so the title bar and the
         toolbar read as one surface, the way a native Mac app does. Aero snap,
         resize and double-click-to-maximise all still come from the system. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
        <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="V" Modifiers="Control" Command="ApplicationCommands.Paste" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
        <CommandBinding Command="ApplicationCommands.New"  Executed="NewPage_Executed" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" />
    </Window.CommandBindings>

    <!-- RootBorder carries the maximise inset; see MainWindow.xaml.cs. -->
    <Border x:Name="RootBorder" Background="{DynamicResource ChromeBrush}">
        <DockPanel>

            <!-- ========================= Caption ========================= -->
            <Grid DockPanel.Dock="Top" Height="40" Background="{DynamicResource ChromeBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Data="{StaticResource IconPen}" Width="15" Height="15"
                          Stretch="Uniform" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stroke="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Scribe" Margin="9,0,0,0"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="14.5"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="Minimise_Click" Style="{DynamicResource CaptionButtonStyle}"
                            ToolTip="Minimise">
                        <Path Data="{StaticResource IconWinMinimise}" Width="10" Height="10"
                              Stretch="Uniform" StrokeThickness="1.1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaxButton" Click="MaxRestore_Click"
                            Style="{DynamicResource CaptionButtonStyle}" ToolTip="Maximise">
                        <Path x:Name="MaxGlyph" Data="{StaticResource IconWinMaximise}"
                              Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Click="CloseWindow_Click" Style="{DynamicResource CloseButtonStyle}"
                            ToolTip="Close">
                        <Path Data="{StaticResource IconWinClose}" Width="10" Height="10"
                              Stretch="Uniform" StrokeThickness="1.1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================= Toolbar ========================= -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,10,10">
                <DockPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button x:Name="UndoButton" Click="Undo_Click"
                                Style="{DynamicResource IconButtonStyle}" ToolTip="Undo  (Ctrl+Z)">
                            <Path Data="{StaticResource IconUndo}" Style="{DynamicResource SmallIconPathStyle}" />
                        </Button>
                        <Button x:Name="RedoButton" Click="Redo_Click"
                                Style="{DynamicResource IconButtonStyle}" ToolTip="Redo  (Ctrl+Y)">
                            <Path Data="{StaticResource IconRedo}" Style="{DynamicResource SmallIconPathStyle}" />
                        </Button>
                        <Rectangle Width="1" Height="18" Margin="10,0"
                                   Fill="{DynamicResource BorderBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLabel" Text=""
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="11" Foreground="{DynamicResource FaintTextBrush}" />

                        <Button x:Name="ThemeButton" Click="Theme_Click"
                                Style="{DynamicResource IconButtonStyle}" ToolTip="Switch theme">
                            <Path x:Name="ThemeIcon" Data="{StaticResource IconSun}"
                                  Style="{DynamicResource SmallIconPathStyle}" />
                        </Button>

                        <Button Click="Import_Click" Style="{DynamicResource QuietButtonStyle}"
                                ToolTip="Copy your OneNote notebooks into Scribe">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconImport}"
                                      Style="{DynamicResource SmallIconPathStyle}" />
                                <TextBlock Text="Import" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Tools, swatches and thickness. Wrapped so a narrow
                         window folds the row rather than clipping it. -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Border Background="{DynamicResource RailBrush}" CornerRadius="10"
                                Padding="3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="PenToolButton" IsChecked="True" Tag="Pen"
                                              Click="Tool_Click" Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Pen  (P)">
                                    <Path Data="{StaticResource IconPen}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="MarkerToolButton" Tag="Highlighter"
                                              Click="Tool_Click" Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Highlighter  (H)">
                                    <Path Data="{StaticResource IconHighlighter}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="EraserToolButton" Tag="StrokeEraser"
                                              Click="Tool_Click" Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Eraser  (E) — press again for a partial eraser">
                                    <Path Data="{StaticResource IconEraser}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="SelectToolButton" Tag="Select"
                                              Click="Tool_Click" Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Lasso select  (S)">
                                    <Path Data="{StaticResource IconLasso}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="TextToolButton" Tag="Text"
                                              Click="Tool_Click" Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Text  (T) — click anywhere on the page">
                                    <Path Data="{StaticResource IconText}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="PenTray" VerticalAlignment="Center" Margin="0,0,10,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Thickness" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource FaintTextBrush}" Margin="0,0,9,0" />
                            <Slider x:Name="WidthSlider" Width="104" Minimum="0.4" Maximum="24"
                                    Value="2.4" VerticalAlignment="Center"
                                    TickFrequency="0.2" IsSnapToTickEnabled="True"
                                    ValueChanged="WidthSlider_Changed" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Paper" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource FaintTextBrush}" Margin="0,0,9,0" />
                            <ComboBox x:Name="PaperCombo" Width="94" VerticalAlignment="Center"
                                      SelectionChanged="Paper_Changed">
                                <ComboBoxItem Content="Ruled" Tag="ruled" IsSelected="True" />
                                <ComboBoxItem Content="Grid"  Tag="grid" />
                                <ComboBoxItem Content="Dots"  Tag="dots" />
                                <ComboBoxItem Content="Blank" Tag="blank" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Insert group: Table, LaTeX, Image -->
                        <Border Background="{DynamicResource RailBrush}" CornerRadius="10"
                                Padding="3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TableButton" Click="InsertTable_Click"
                                        Style="{DynamicResource IconButtonStyle}"
                                        ToolTip="Insert Table">
                                    <Path Data="{StaticResource IconTable}" Style="{DynamicResource IconPathStyle}" />
                                </Button>
                                <Button x:Name="LatexButton" Click="InsertLatex_Click"
                                        Style="{DynamicResource IconButtonStyle}"
                                        ToolTip="LaTeX Equation Formatter">
                                    <Path Data="{StaticResource IconFormula}" Style="{DynamicResource IconPathStyle}" />
                                </Button>
                                <Button x:Name="ImageButton" Click="InsertImage_Click"
                                        Style="{DynamicResource IconButtonStyle}"
                                        ToolTip="Insert or Paste Image  (Ctrl+V)">
                                    <Path Data="{StaticResource IconImage}" Style="{DynamicResource IconPathStyle}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Text formatting group -->
                        <Border Background="{DynamicResource RailBrush}" CornerRadius="10"
                                Padding="4,3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Heading / Style Selector -->
                                <ComboBox x:Name="StyleCombo" Width="100" Margin="0,0,4,0"
                                          VerticalAlignment="Center" SelectionChanged="StyleCombo_Changed">
                                    <ComboBoxItem Content="Body" Tag="body" IsSelected="True" />
                                    <ComboBoxItem Content="Title" Tag="title" />
                                    <ComboBoxItem Content="Heading 1" Tag="h1" />
                                    <ComboBoxItem Content="Heading 2" Tag="h2" />
                                    <ComboBoxItem Content="Heading 3" Tag="h3" />
                                    <ComboBoxItem Content="Handwritten" Tag="handwritten" />
                                </ComboBox>

                                <!-- Font Family Selector -->
                                <ComboBox x:Name="FontFamilyCombo" Width="110" Margin="0,0,4,0"
                                          VerticalAlignment="Center" SelectionChanged="FontFamilyCombo_Changed">
                                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" IsSelected="True" />
                                    <ComboBoxItem Content="Handwritten" Tag="Handwritten" />
                                    <ComboBoxItem Content="Georgia" Tag="Georgia" />
                                    <ComboBoxItem Content="Cascadia" Tag="Cascadia Code" />
                                    <ComboBoxItem Content="Arial" Tag="Arial" />
                                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                    <ComboBoxItem Content="Comic Sans" Tag="Comic Sans MS" />
                                </ComboBox>

                                <!-- Font Size Selector -->
                                <ComboBox x:Name="FontSizeCombo" Width="60" Margin="0,0,4,0"
                                          VerticalAlignment="Center" SelectionChanged="FontSizeCombo_Changed">
                                    <ComboBoxItem Content="11" Tag="11" />
                                    <ComboBoxItem Content="12" Tag="12" />
                                    <ComboBoxItem Content="13" Tag="13" />
                                    <ComboBoxItem Content="14" Tag="14" IsSelected="True" />
                                    <ComboBoxItem Content="15" Tag="15" />
                                    <ComboBoxItem Content="16" Tag="16" />
                                    <ComboBoxItem Content="18" Tag="18" />
                                    <ComboBoxItem Content="20" Tag="20" />
                                    <ComboBoxItem Content="24" Tag="24" />
                                    <ComboBoxItem Content="28" Tag="28" />
                                    <ComboBoxItem Content="32" Tag="32" />
                                    <ComboBoxItem Content="40" Tag="40" />
                                </ComboBox>

                                <!-- Formatting Toggles -->
                                <ToggleButton x:Name="BoldButton" Click="Bold_Click"
                                              Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Bold  (Ctrl+B)">
                                    <Path Data="{StaticResource IconBold}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="ItalicButton" Click="Italic_Click"
                                              Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Italic  (Ctrl+I)">
                                    <Path Data="{StaticResource IconItalic}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="UnderlineButton" Click="Underline_Click"
                                              Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Underline  (Ctrl+U)">
                                    <Path Data="{StaticResource IconUnderline}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="StrikethroughButton" Click="Strikethrough_Click"
                                              Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Strikethrough">
                                    <Path Data="{StaticResource IconStrikethrough}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                                <ToggleButton x:Name="HandwrittenButton" Click="Handwritten_Click"
                                              Style="{DynamicResource ToolButtonStyle}"
                                              ToolTip="Handwritten font style">
                                    <Path Data="{StaticResource IconHandwriting}" Style="{DynamicResource IconPathStyle}" />
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- =========================== Body ========================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RailColumn" Width="228" MinWidth="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PagesColumn" Width="256" MinWidth="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Notebooks and sections -->
                <Border Grid.Column="0" Background="{DynamicResource RailBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="NOTEBOOKS" Style="{DynamicResource RailHeaderStyle}" />
                            <Button HorizontalAlignment="Right" Margin="0,7,12,0"
                                    Style="{DynamicResource IconButtonStyle}"
                                    Click="NewNotebook_Click" ToolTip="New notebook">
                                <Path Data="{StaticResource IconPlus}" Style="{DynamicResource SmallIconPathStyle}" />
                            </Button>
                        </Grid>

                        <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                                  Padding="0,2,0,10"
                                  SelectedItemChanged="Tree_SelectedItemChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type models:NotebookItem}"
                                                          ItemsSource="{Binding Sections}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="3" Height="15" RadiusX="1.5" RadiusY="1.5"
                                                   Margin="0,0,9,0" Fill="{Binding Color}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>

                                <DataTemplate DataType="{x:Type models:SectionItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="1,0,9,0"
                                                 VerticalAlignment="Center" Fill="{Binding Color}" />
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>

                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New section" Click="NewSection_Click" />
                                    <MenuItem Header="Rename…"     Click="RenameItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Reveal in File Explorer" Click="Reveal_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete"      Click="DeleteItem_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                              Background="Transparent" />

                <!-- Pages -->
                <Border Grid.Column="2" Background="{DynamicResource RailBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="PAGES" Style="{DynamicResource RailHeaderStyle}" />
                            <Button HorizontalAlignment="Right" Margin="0,7,12,0"
                                    Style="{DynamicResource IconButtonStyle}"
                                    Click="NewPage_Click" ToolTip="New page  (Ctrl+N)">
                                <Path Data="{StaticResource IconPlus}" Style="{DynamicResource SmallIconPathStyle}" />
                            </Button>
                        </Grid>

                        <Grid DockPanel.Dock="Top" Margin="12,2,12,8">
                            <TextBox x:Name="SearchBox" Padding="30,6,9,6"
                                     TextChanged="Search_TextChanged"
                                     ToolTip="Search page titles and typed text  (Ctrl+F)" />
                            <Path Data="{StaticResource IconSearch}" Width="13" Height="13"
                                  Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{DynamicResource FaintTextBrush}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="11,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="Search" IsHitTestVisible="False"
                                       Margin="31,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       Foreground="{DynamicResource FaintTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ListBox x:Name="PageList" Style="{DynamicResource RailListStyle}"
                                 SelectionChanged="PageList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="{DynamicResource FontSizeBody}" />
                                        <TextBlock Text="{Binding ModifiedLabel}" FontSize="10.5"
                                                   Margin="0,2,0,0" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename…" Click="RenamePage_Click" />
                                    <MenuItem Header="Delete"  Click="DeletePage_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch"
                              Background="Transparent" />

                <!-- Editor -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1"
                            Padding="34,16,34,14">
                        <TextBox x:Name="TitleBox"
                                 FontFamily="{DynamicResource DisplayFont}"
                                 FontSize="{DynamicResource FontSizeTitle}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 Text="" TextChanged="Title_TextChanged"
                                 IsEnabled="False" />
                    </Border>

                    <controls:PageCanvas x:Name="PageView" Grid.Row="1" />

                    <Border x:Name="EmptyState" Grid.Row="1"
                            Background="{DynamicResource CanvasBackdropBrush}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                            <Path Data="{StaticResource IconNotebook}" Width="34" Height="34"
                                  Stretch="Uniform" StrokeThickness="1.1"
                                  StrokeLineJoin="Round"
                                  Stroke="{DynamicResource FaintTextBrush}"
                                  HorizontalAlignment="Center" Margin="0,0,0,18" />
                            <TextBlock Text="Nothing open"
                                       FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="21" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                                       LineHeight="20"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Choose a page on the left, or bring your OneNote notebooks across." />
                            <Button Content="Import from OneNote" Margin="0,22,0,0"
                                    HorizontalAlignment="Center" Click="Import_Click" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
