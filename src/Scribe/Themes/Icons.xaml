<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Line icons on a 24x24 grid, drawn as open paths and stroked rather
         than filled. Stroked icons stay even in weight next to text at any
         size, and they inherit the button's foreground so selected and hover
         states tint them automatically. -->

    <!-- A pen held at an angle, nib at lower left. -->
    <StreamGeometry x:Key="IconPen">M3.5 20.5 L4.2 16.6 L16.1 4.7 A2.4 2.4 0 0 1 19.5 8.1 L7.6 20 Z M14.2 6.6 L17.6 10</StreamGeometry>

    <!-- Chisel-tip marker with a wash beneath it. -->
    <StreamGeometry x:Key="IconHighlighter">M6 15.5 L14.5 7 A2.2 2.2 0 0 1 17.6 10.1 L9.1 18.6 L5.4 19.3 Z M4 21.5 H20</StreamGeometry>

    <!-- Eraser tilted on the page, sitting on a baseline. Without the baseline
         the rotated block just reads as a diamond. -->
    <StreamGeometry x:Key="IconEraser">M8.8 17.8 L3.9 12.9 A1.7 1.7 0 0 1 3.9 10.5 L11 3.4 A1.7 1.7 0 0 1 13.4 3.4 L19.4 9.4 A1.7 1.7 0 0 1 19.4 11.8 L13.4 17.8 Z M7.6 6.8 L16 15.2 M6.5 20.8 H20.5</StreamGeometry>

    <!-- Lasso: an open loop whose ends cross into a hanging rope. Closing the
         loop and adding a stub instead makes it read as a speech bubble. -->
    <StreamGeometry x:Key="IconLasso">M9.6 16.9 C6 16.2 3.4 14 3.4 10.8 C3.4 7.2 7.2 4.4 12 4.4 C16.8 4.4 20.6 7.2 20.6 10.8 C20.6 13.6 18.3 16 15 16.6 M9.6 16.9 C11 17.4 11.4 18.4 10.7 19.4 C10 20.4 8.6 20.5 8 19.6</StreamGeometry>

    <!-- A serif T, matching the text tool's job. -->
    <StreamGeometry x:Key="IconText">M5 5.5 H19 M12 5.5 V19 M9 19 H15</StreamGeometry>

    <StreamGeometry x:Key="IconUndo">M9.5 15 L4.5 10 L9.5 5 M4.5 10 H14 A5 5 0 0 1 14 20 H10.5</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M14.5 15 L19.5 10 L14.5 5 M19.5 10 H10 A5 5 0 0 0 10 20 H13.5</StreamGeometry>

    <StreamGeometry x:Key="IconPlus">M12 5.5 V18.5 M5.5 12 H18.5</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M11 4.5 A6.5 6.5 0 1 1 11 17.5 A6.5 6.5 0 1 1 11 4.5 Z M15.8 15.8 L20 20</StreamGeometry>

    <!-- Sun and moon for the theme switch. -->
    <StreamGeometry x:Key="IconSun">M12 7.5 A4.5 4.5 0 1 1 12 16.5 A4.5 4.5 0 1 1 12 7.5 Z M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M18.7 5.3 L17.3 6.7 M6.7 17.3 L5.3 18.7</StreamGeometry>
    <StreamGeometry x:Key="IconMoon">M20 14.2 A8.5 8.5 0 1 1 9.8 4 A6.8 6.8 0 0 0 20 14.2 Z</StreamGeometry>

    <!-- Import: a page with an arrow coming down into it. -->
    <StreamGeometry x:Key="IconImport">M12 3.5 V14 M8 10.5 L12 14.5 L16 10.5 M4.5 16.5 V19 A1.5 1.5 0 0 0 6 20.5 H18 A1.5 1.5 0 0 0 19.5 19 V16.5</StreamGeometry>

    <StreamGeometry x:Key="IconNotebook">M6 3.5 H18 A1 1 0 0 1 19 4.5 V19.5 A1 1 0 0 1 18 20.5 H6 A1 1 0 0 1 5 19.5 V4.5 A1 1 0 0 1 6 3.5 Z M9 3.5 V20.5</StreamGeometry>

    <!-- Window caption glyphs, on a 10x10 grid. -->
    <StreamGeometry x:Key="IconWinMinimise">M0 5 H10</StreamGeometry>
    <StreamGeometry x:Key="IconWinMaximise">M0.5 0.5 H9.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconWinRestore">M0.5 2.5 H7.5 V9.5 H0.5 Z M2.5 2.5 V0.5 H9.5 V7.5 H7.5</StreamGeometry>
    <StreamGeometry x:Key="IconWinClose">M0.5 0.5 L9.5 9.5 M9.5 0.5 L0.5 9.5</StreamGeometry>

</ResourceDictionary>
